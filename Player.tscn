[sub_resource type="GDScript" id="GDScript_iqovn"]
script/source = "extends CharacterBody2D

@export var speed = 200

var current_xp = 0
var next_level_xp = 10
var level = 1

func _physics_process(delta):
	var direction = Vector2.ZERO

	direction.x = Input.get_action_strength(\"ui_right\") - Input.get_action_strength(\"ui_left\")
	direction.y = Input.get_action_strength(\"ui_down\") - Input.get_action_strength(\"ui_up\")

	velocity = direction.normalized() * speed
	move_and_slide()


@export var projectile_scene: PackedScene

func _input(event):
	if event is InputEventMouseButton and event.pressed:
		shoot()

func shoot():
	var projectile = projectile_scene.instantiate()

	var mouse_pos = get_global_mouse_position()
	var dir = (mouse_pos - global_position).normalized()
	projectile.position = global_position
	projectile.direction = dir

	get_parent().add_child(projectile)

	$Camera2D.apply_shake(3.0) # Uma trepidação menor só pelo disparo

func level_up():
	level += 1
	current_xp = 0
	next_level_xp *= 1.5 # Aumenta a dificuldade do próximo nível
	speed += 20 # Exemplo de progressão: fica mais rápido
	print(\"O Vazio se fortalece. Nível: \", level)

func gain_xp(amount):
	current_xp += amount
	print(\"Vazio absorveu alma. XP Atual: \", current_xp) # Feedback no console
	
	if current_xp >= next_level_xp:
		level_up()
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_ngy1p"]
