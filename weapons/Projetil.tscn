[sub_resource type="GDScript" id="GDScript_4dvx7"]
resource_name = "projetil"
script/source = "extends Area2D

@export var speed: float = 600.0 # Um pouco mais rápido para o \"feeling\" de Diablo
var direction: Vector2 = Vector2.ZERO
var damage: int = 1

func _ready():
	# 1. Rotaciona o visual para a direção certa
	if direction != Vector2.ZERO:
		rotation = direction.angle()
	
	# 2. Timer de segurança: Se o tiro não acertar nada em 3 segundos, ele some sozinho
	# Isso evita que o jogo trave por excesso de objetos (Mecânica Central)
	var timer = get_tree().create_timer(3.0)
	timer.timeout.connect(queue_free)

func _process(delta):
	# Movimentação baseada na direção (Interação Jogável)
	global_position += direction * speed * delta

func _on_body_entered(body):
	# 3. LOG: Ajuda você a ver no console o que o tiro acertou
	print(\"Projétil atingiu: \", body.name)
	
	# 4. Dano e Morte (Passo 3: Lógica de Interação)
	if body.has_method(\"take_damage\"):
		body.take_damage(damage, direction)
		
		# Feedback Visual: Tremor de câmera no acerto
		var camera = get_viewport().get_camera_2d()
		if camera and camera.has_method(\"apply_shake\"):
			camera.apply_shake(5.0)
			
		queue_free() # Tiro some ao acertar inimigo
	
	# 5. Colisão com o cenário (Passo 2: Objetos de Colisão)
	elif body is TileMapLayer or body is StaticBody2D:
		queue_free() # Tiro some ao bater na parede	
"

