[sub_resource type="GDScript" id="GDScript_4dvx7"]
resource_name = "projetil"
script/source = "extends Area2D

@export var speed: float = 500.0
var direction: Vector2 = Vector2.ZERO
var damage: int = 1

func _ready():
	# Isso vai aparecer no console (aba Saída) toda vez que você atirar
	print(\"Tiro disparado de: \", global_position)
	
	# Opcional: Destrói o tiro sozinho após 2 segundos para não pesar o jogo
	await get_tree().create_timer(2.0).timeout
	if is_inside_tree():
		queue_free()

func _process(delta):
	# Movimentação simples
	position += direction * speed * delta

func _on_body_entered(body):
	# Esse print é fundamental! Se ele não aparecer quando bater no zumbi,
	# o problema é a Colisão (Layers) ou o Sinal (Signal).
	print(\"Projétil encostou em algo: \", body.name)
	
	if body.has_method(\"take_damage\"):
		print(\"DANDO DANO NO ZUMBI!\")
		body.take_damage(damage)
		
		# Tenta tremer a câmera se ela existir
		var camera = get_viewport().get_camera_2d()
		if camera and camera.has_method(\"apply_shake\"):
			camera.apply_shake(5.0)
			
		queue_free() # Some após o impacto
	
	# Se bater em paredes do mapa (TileMap ou StaticBody)
	elif body is TileMapLayer or body is StaticBody2D:
		queue_free()
"

