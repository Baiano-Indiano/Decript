[sub_resource type="GDScript" id="GDScript_r0du0"]
script/source = "extends Node2D

# Aqui vamos carregar a cena do zumbi que você criou
@export var inimigo_scene: PackedScene

func _ready():
	# Inicia o Timer assim que o jogo começa
	$Timer.start()

func _on_timer_timeout():
	# 1. Cria uma instância do inimigo
	var inimigo = inimigo_scene.instantiate()
	
	# 2. Define uma posição aleatória (ajuste os números conforme o tamanho do seu mapa)
	# Vamos fazer eles aparecerem num raio ao redor do centro
	var pos_x = randf_range(-500, 500)
	var pos_y = randf_range(-500, 500)
	inimigo.global_position = Vector2(pos_x, pos_y)
	
	# 3. Adiciona o inimigo na cena
	add_child(inimigo)
	print(\"Novo zumbi surgiu em: \", inimigo.global_position)

@onready var xp_bar = $HUD/Control/XPBar
@onready var level_label = $HUD/Control/LevelLabel
@onready var player = $Player

func _process(_delta):
	if is_instance_valid(player):
		# Atualiza a barra de XP
		xp_bar.max_value = player.next_level_xp
		xp_bar.value = player.current_xp
		
		# Atualiza o texto do nível
		level_label.text = \"Nível: \" + str(player.level)
	if $Player.level > 1:
	# Diminui o tempo de spawn conforme o nível aumenta (mais difícil)
		$Timer.wait_time = max(0.5, 2.0 - ($Player.level * 0.2))
"

